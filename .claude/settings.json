{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-tool-use.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post-tool-use.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "판단 범위는 **마지막 사용자 메시지 이후의 턴**만입니다 (대화 전체가 아님). 그 범위에서 파일을 수정한 적이 있는지 확인하세요 (Edit/Write 도구뿐 아니라 Bash의 리다이렉션·heredoc으로 파일에 쓴 경우도 포함). 수정이 없었다면 (분석·설명·질문 답변만 했다면) {\"ok\": true} 로 즉시 응답하세요. 수정이 있었다면: 1) 에러 핸들링 누락, 2) 코드 로직을 변경했는데 관련 테스트를 실행하지 않았거나 실패를 방치함 (테스트가 없는 프로젝트나 문서·설정 전용 변경이면 이 항목은 건너뜀), 3) 관련 문서 동기화 누락, 4) 작업 단위가 완료되었는데 .claude/JOURNAL.md에 시점과 함께 기록되지 않음, 5) .claude/CURRENT_TASK.md가 현재 상태와 다름(완료 항목이 남아있으면 저널로 이동 후 제거), 6) 작업 단위가 완료되었는데 커밋되지 않은 변경이 남아있음을 사용자에게 알리지 않음 (커밋 여부는 사용자 결정, 알림만 필수) — 중 해당하는 것이 있으면 {\"ok\": false, \"reason\": \"[이유]\"}, 없으면 {\"ok\": true} 로 응답하세요. 아직 진행 중인 작업이면 저널·커밋 항목은 요구하지 마세요."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*)",
      "Read(./**/*secret*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(git push --force)",
      "Bash(git push --force:*)",
      "Bash(git push -f)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd)",
      "Bash(git clean -fd:*)"
    ]
  }
}
